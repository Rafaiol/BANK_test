# ============================================================
# Smile البديل - Environment Variables Template
# ============================================================
# Add these variables to your Vercel Project Settings > Environment Variables:

# 1. Google Spreadsheet ID (from the sheet URL: /spreadsheets/d/<ID>/edit)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# 2. Google Cloud Service Account Email
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# 3. Google Cloud Service Account Private Key (including BEGIN and END lines, with \n)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"
